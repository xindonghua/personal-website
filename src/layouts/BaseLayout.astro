---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 当前页面标识，用于导航高亮，如 home / resume / blog / works */
  active?: string;
}

const {
  title,
  description = '董东华的个人网站：简历、生活记录与作品。',
  active = '',
} = Astro.props;

const siteName = '董东华';
const nav = [
  { href: '/', label: '首页', key: 'home' },
  { href: '/resume', label: '简历', key: 'resume' },
  { href: '/blog', label: '生活记录', key: 'blog' },
  { href: '/works', label: '作品', key: 'works' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{active === 'home' ? `${siteName} · 个人主页` : `${title} · ${siteName}`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{siteName}<span class="dot">.</span></a>
        <nav class="nav">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {siteName} · 保留所有权利</span>
        <span>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></span>
      </div>
    </footer>
  </body>
</html>
