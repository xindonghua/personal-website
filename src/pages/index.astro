---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout title="个人主页" active="home">
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Portfolio — 2026</p>
        <h1>写代码的人，<br />也记录生活。</h1>
        <p class="hero-lede">
          计算机专业在读，关注算法与工程实践。这个站点放三样东西：一份持续更新的简历、
          一些做完的作品，以及值得留下的生活片段。
        </p>
        <div class="hero-actions">
          <a class="link-more" href="/resume">查看简历</a>
          <a class="link-more" href="/works">浏览作品</a>
        </div>
      </div>

      <figure class="hero-media">
        <img
          src="/uploads/portrait.jpg"
          alt="辛东华在冰雕前的照片"
          width="720"
          height="960"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Fig. 00 · 生活照</figcaption>
      </figure>
    </section>

    <section class="fig">
      <div class="fig-head">
        <span class="fig-num">Fig. 01</span>
        <h2 class="fig-title">简历</h2>
        <span class="fig-note">持续更新</span>
      </div>
      <div class="fig-body">
        <p>
          教育背景、专业技能与项目经历，压缩在一页里。也支持直接打印或导出 PDF，
          方便发给需要的人。
        </p>
        <a class="link-more" href="/resume">打开简历</a>
      </div>
    </section>

    <section class="fig">
      <div class="fig-head">
        <span class="fig-num">Fig. 02</span>
        <h2 class="fig-title">作品</h2>
        <span class="fig-note">整理中</span>
      </div>
      <ul class="entry-list">
        <li class="entry">
          <span class="entry-num">01</span>
          <div>
            <a class="entry-link" href="/works">
              <span class="entry-title">项目与练习的归档</span>
            </a>
            <p class="entry-desc">
              做过的项目、写过的工具和折腾出来的小东西，会陆续整理到这里，附上截图与技术要点。
            </p>
            <p class="entry-meta">Works — Soon</p>
          </div>
        </li>
      </ul>
    </section>

    <section class="fig">
      <div class="fig-head">
        <span class="fig-num">Fig. 03</span>
        <h2 class="fig-title">生活记录</h2>
        <span class="fig-note">最新 3 篇</span>
      </div>

      {
        posts.length === 0 ? (
          <div class="empty">还没有记录。在 src/content/posts 里写第一篇即可。</div>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>
                  <span class="post-date">{fmt(post.data.pubDate)}</span>
                  <span>
                    <span class="post-title">{post.data.title}</span>
                    {post.data.description && <p class="post-desc">{post.data.description}</p>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p style="margin-top: 28px;">
        <a class="link-more" href="/blog">全部记录</a>
      </p>
    </section>
  </div>
</BaseLayout>
