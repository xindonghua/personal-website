---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout title="个人主页" active="home">
  <section class="hero">
    <div class="avatar">董</div>
    <div>
      <h1>董东华</h1>
      <p class="tagline">写代码，也记录生活。</p>
      <p style="color: var(--ink-2); max-width: 560px;">
        这里是我的个人主页，用来安放三样东西：一份持续更新的简历、一些值得留下的生活片段，
        以及做过的一些作品。内容会慢慢长出来，欢迎常来看看。
      </p>
      <div class="meta-links">
        <a href="mailto:xindongsh@163.com">邮箱</a>
        <a href="https://github.com/" target="_blank" rel="noopener">GitHub</a>
        <a href="/resume">查看简历 →</a>
      </div>
    </div>
  </section>

  <div class="section-title">
    <h2>站点导航</h2>
  </div>

  <div class="cards">
    <a class="card" href="/resume">
      <div class="icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <path d="M14 2v6h6M9 13h6M9 17h4" />
        </svg>
      </div>
      <h3>简历</h3>
      <p>教育背景、专业技能与项目经历，一页看完。</p>
    </a>

    <a class="card" href="/blog">
      <div class="icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
        </svg>
      </div>
      <h3>生活记录</h3>
      <p>随手写下的事，配图片和视频，按时间归档。</p>
    </a>

    <a class="card" href="/works">
      <div class="icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5" />
          <rect x="14" y="3" width="7" height="7" rx="1.5" />
          <rect x="3" y="14" width="7" height="7" rx="1.5" />
          <rect x="14" y="14" width="7" height="7" rx="1.5" />
        </svg>
      </div>
      <h3>作品</h3>
      <p>项目、练习与折腾过的东西，正在整理中。</p>
    </a>
  </div>

  <div class="section-title">
    <h2>最近的生活记录</h2>
    <a class="more" href="/blog">全部记录 →</a>
  </div>

  {
    posts.length === 0 ? (
      <div class="empty">还没有文章，去 src/content/posts 新建一篇吧。</div>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <span class="post-date">{fmt(post.data.pubDate)}</span>
              <span>
                <span class="post-title">{post.data.title}</span>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
